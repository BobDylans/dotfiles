// 开发工作区 Layout
// 使用: zellij --layout dev
// 或: zellij attach dev --layout dev

layout {
    // 左侧大 pane：主工作区（编辑/主终端）
    pane size="65%" focus=true

    // 右侧上下两个小 pane
    // split_direction="vertical" => 上下堆叠（zellij 语义：沿垂直方向切分）
    pane size="35%" split_direction="vertical" borderless=true {
        pane size="60%" name="terminal"
        pane size="40%" name="monitor" command="btop"
    }
}
