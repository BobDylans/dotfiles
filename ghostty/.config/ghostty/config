# ═══════════════════════════════════════
#  Ghostty 配置 — 基于 kitty 配置迁移 + 美化
# ═══════════════════════════════════════

# -- 窗口 --
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = false
background-opacity = 0.75
background-opacity-cells = false
background-blur = false
confirm-close-surface = false
window-theme = ghostty
mouse-hide-while-typing = true
focus-follows-mouse = true
unfocused-split-opacity = 0.85

# -- 字体 --
font-family = JetBrains Maple Mono
font-size = 13.5
font-feature = calt
font-feature = zero
font-feature = ss01
font-feature = ss02
font-synthetic-style = false
font-thicken = true

# -- Shell --
shell-integration = detect
shell-integration-features = no-cursor

# -- 光标 --
cursor-style = bar
cursor-style-blink = true

# -- 滚动 --
scrollback-limit = 100000
mouse-scroll-multiplier = 3
progress-style = true
async-backend = auto

# -- 通知与提示 --
notify-on-command-finish = always
notify-on-command-finish-after = 5s
app-notifications = clipboard-copy,config-reload
desktop-notifications = true
bell-features = no-system,no-audio,attention,title,no-border
faint-opacity = 0.6

# -- GTK --
gtk-titlebar = false
gtk-tabs-location = top
gtk-wide-tabs = true
gtk-titlebar-style = native
linux-cgroup = single-instance

# -- 主题（迁移自 kitty dank-theme） --
foreground = #e2e2e6
background = #111416
cursor-color = #e2e2e6
cursor-text = #c2c7cf
selection-foreground = #223241
selection-background = #b8c8dc
minimum-contrast = 1.1
bold-color = #eff7ff

palette = 0=#111416
palette = 1=#ff729c
palette = 2=#7cf88c
palette = 3=#fff772
palette = 4=#86b8eb
palette = 5=#274c72
palette = 6=#9fcbf8
palette = 7=#eff7ff
palette = 8=#959ba1
palette = 9=#ff9fbb
palette = 10=#a5ffb1
palette = 11=#fffaa5
palette = 12=#b1d7ff
palette = 13=#bedeff
palette = 14=#d5eaff
palette = 15=#f8fbff

# -- 快捷键 --
# Alt+左右切换标签
keybind = alt+left=previous_tab
keybind = alt+right=next_tab
# Alt+数字切标签
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab
# 新开/关闭标签
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
# 分屏
keybind = ctrl+shift+left=new_split:right
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+up=new_split:down
# 分屏导航
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
# 分屏缩放（全屏当前分屏）
keybind = ctrl+shift+z=toggle_split_zoom
# 复制/粘贴
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
# 字体大小
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
# 搜索
keybind = ctrl+shift+f=start_search
# 全屏/最大化
keybind = super+enter=toggle_fullscreen
keybind = super+m=toggle_maximize
# 命令面板
keybind = ctrl+shift+p=toggle_command_palette
theme = noctalia
